# Public site domain used for canonical URLs, sitemap.xml, and robots.txt
NEXT_PUBLIC_SITE_URL=https://homeenergycalcs.com

# Optional public contact email shown on About and Privacy pages
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# Google Tag / Google Analytics 4 (required when applying to Journey by Mediavine)
# NEXT_PUBLIC_GOOGLE_TAG_ID=GTM-KLKPB4WP
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Google AdSense Publisher ID (ca-pub-XXXXXXXXXXXXXXXX)
# NEXT_PUBLIC_ADSENSE_CLIENT=

# Free U.S. Energy Information Administration API Key (used only by scripts/fetch_eia_rates.py)
# EIA_API_KEY=your_free_eia_api_key
